
# ============================================
# Azure Voice Live API Configuration (Required)
# ============================================
# Your Azure Cognitive Services endpoint for Voice Live
AZURE_VOICELIVE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_VOICELIVE_API_VERSION=2025-10-01

# ============================================
# Azure AI Foundry / Agents Configuration (Required for Agent quickstart)
# ============================================
# Your Azure AI Foundry project endpoint
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
# Your Foundry API key
FOUNDRY_KEY=<your-foundry-api-key>

# ============================================
# Voice Model Configuration
# ============================================
# Choose a voice model (tone). Examples:
#   en-IN-Aarti:DragonHDV2.3Neural
#   en-IN-Meera:DragonHDIndicLatestNeural
# See: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
AZURE_VOICELIVE_VOICE=en-IN-Meera:DragonHDIndicLatestNeural

# System message / instructions for the model -- better to provide from system_instructions.py file
AZURE_VOICELIVE_INSTRUCTIONS=""

# ============================================
# Azure OpenAI Realtime Configuration
# ============================================
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_RT_DEPLOYMENT=gpt-realtime
OPENAI_VOICE=marin
AZURE_OPENAI_RT_TEMPERATURE=0.8

# ============================================
# Bring Your Own Model (BYOM) Settings (Optional)
# ============================================
# Model deployment name in your Azure OpenAI resource
AZURE_VOICELIVE_MODEL=gpt-realtime
# BYOM mode: byom-azure-openai-chat-completion
AZURE_VOICELIVE_BYOM_MODE=byom-azure-openai-chat-completion

# ============================================
# Agent Quickstart Settings (Optional)
# ============================================
# Your Azure AI Foundry project name
AZURE_VOICELIVE_PROJECT_NAME=<your-project-name>
# Your Agent ID (created in Azure AI Foundry)
AZURE_VOICELIVE_AGENT_ID=<your-agent-id>

# ============================================
# Voice Configuration Parameters
# ============================================
# Voice temperature: Controls variability in intonation (0.0-2.0, only for HD voices)
AZURE_VOICELIVE_VOICE_TEMPERATURE=0.8

# Speaking rate: Controls speed of speech (0.5-1.5)
AZURE_VOICELIVE_VOICE_RATE=1.1

# ============================================
# Turn Detection (VAD) Configuration
# ============================================
# VAD Type: server_vad, azure_semantic_vad, or azure_multilingual_semantic_vad
AZURE_VOICELIVE_VAD_TYPE=azure_semantic_vad

# VAD threshold: Higher = requires stronger signal (0.0-1.0)
AZURE_VOICELIVE_VAD_THRESHOLD=0.7

# Prefix padding: Audio captured before speech start (ms)
AZURE_VOICELIVE_VAD_PREFIX_PADDING_MS=500

# Silence duration: Silence needed to detect speech end (ms)
AZURE_VOICELIVE_VAD_SILENCE_DURATION_MS=300

# Speech duration: Minimum speech duration to start detection (ms)
AZURE_VOICELIVE_VAD_SPEECH_DURATION_MS=300

# Remove filler words: Filter "umm", "ah", etc. (True/False)
AZURE_VOICELIVE_VAD_REMOVE_FILLER_WORDS=True

# Enable barge-in interruption (True/False)
AZURE_VOICELIVE_VAD_INTERRUPT_RESPONSE=True

# ============================================
# End of Utterance Detection (Advanced)
# ============================================
# Enable advanced end-of-utterance detection (True/False)
AZURE_VOICELIVE_END_OF_UTTERANCE_ENABLED=False

# Model: semantic_detection_v1 or semantic_detection_v1_multilingual
AZURE_VOICELIVE_END_OF_UTTERANCE_MODEL=semantic_detection_v1

# Threshold level: low, medium, high, or default
# AZURE_VOICELIVE_END_OF_UTTERANCE_THRESHOLD_LEVEL=default

# Timeout: Maximum wait time for detection (ms)
AZURE_VOICELIVE_END_OF_UTTERANCE_TIMEOUT_MS=300

# ============================================
# Audio Configuration
# ============================================
# Input audio sampling rate: 16000 or 24000
AZURE_VOICELIVE_AUDIO_SAMPLE_RATE=24000

# Noise reduction type: azure_deep_noise_suppression or none
AZURE_VOICELIVE_NOISE_REDUCTION_TYPE=azure_deep_noise_suppression

# Enable echo cancellation (True/False)
AZURE_VOICELIVE_ECHO_CANCELLATION_ENABLED=True

# ============================================
# Input Audio Transcription (Multilingual Support)
# ============================================
# Model for transcription - leave empty to use VoiceLive default
AZURE_VOICELIVE_INPUT_TRANSCRIPTION_MODEL=whisper-1

# Language code for transcription
# Supports: single language (e.g., "hi"), (e.g., "en-US"), 
# or MULTIPLE languages with auto-detection (e.g., "en,hi,kn,te")
# Common codes: hi = Hindi, en = English, kn = Kannada, te = Telugu, ta = Tamil
AZURE_VOICELIVE_INPUT_LANGUAGE=en

# ============================================
# Additional Features
# ============================================
# Proactive greeting delay in seconds
AZURE_VOICELIVE_GREETING_DELAY=0.5

# ============================================
# MCP (Model Context Protocol) Configuration (Optional)
# ============================================

# MCP Server URL - The endpoint where your MCP server is hosted
MCP_SERVER_URL=<your-mcp-server-url>

# MCP Server Label - A friendly name/identifier for the MCP server
MCP_SERVER_LABEL=<your-mcp-server-label>

# MCP Allowed Tools - Comma-separated list of tool names to allow (optional)
# Example: MCP_ALLOWED_TOOLS=search,lookup,get_weather
# If not specified, all tools from the server are allowed
MCP_ALLOWED_TOOLS=

# MCP Require Approval - Control when tools need approval before execution
# Options: "always", "never", or JSON like: {"never": ["tool1"], "always": ["tool2"]}
# Default: "always" - requires approval for all tool calls
MCP_REQUIRE_APPROVAL=always

# MCP Authorization - Bearer token or API key for MCP server authentication (optional)
# Example: MCP_AUTHORIZATION=Bearer your-token-here
MCP_AUTHORIZATION=

# ============================================
# Azure API Management (APIM) Configuration (Optional)
# ============================================

# Azure API Management endpoint URL
APIM_ENDPOINT=<your-apim-endpoint-url>

# Azure API Management subscription key (if required by your APIM)
APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>

# ============================================
# Human-in-the-Loop Configuration (Optional)
# ============================================
HUMAN_AGENT_ENDPOINT=<your-human-agent-endpoint-url>